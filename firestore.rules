rules_version = '2';

// ============================================================
//  Firestore Security Rules — Spanish 2000
// ============================================================
//  Each user may read and write ONLY their own document in the
//  "progress" collection. The user is identified via Firebase
//  Auth (Google) — request.auth.uid == userId.
//
//  This is the REAL data protection. The config in firebase-config.js
//  (apiKey etc.) is public; without these rules the database would
//  either be open to everyone or unusable.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /progress/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Everything else is denied (default behaviour = deny).
  }
}
